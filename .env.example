# Nexus-E Edge Stack — Environment Variables
# Copy to .env and fill in required values: cp .env.example .env

# ── General ──────────────────────────────────────────────────────────────────
TZ=UTC
ZONE_ID=zone-01

# ── ThingsBoard Cloud Connection (required) ──────────────────────────────────
TB_CLOUD_HOST=               # IP or hostname of ThingsBoard server
TB_CLOUD_MQTT_PORT=8883      # MQTT port (8883=TLS, 1883=plain)
TB_ACCESS_TOKEN=             # Device access token from ThingsBoard

# ── Node-RED ─────────────────────────────────────────────────────────────────
NODE_RED_CREDENTIAL_SECRET=  # Secret for encrypting Node-RED credentials (required)
# NODE_RED_ADMIN_USER=admin
# NODE_RED_ADMIN_PASS_HASH=   # Generate: node -e "require('bcryptjs').hash('pass',8).then(console.log)"

# ── Dev / Debug ──────────────────────────────────────────────────────────────
# NODERED_BIND=0.0.0.0       # Expose Node-RED externally (default: 127.0.0.1, localhost only)

# ── OPC-UA ───────────────────────────────────────────────────────────────────
# OPCUA_HOST=127.0.0.1
# OPCUA_PORT=4840
# OPCUA_DEVICE_ID=opcua-001

# ── BACnet ───────────────────────────────────────────────────────────────────
# BACNET_INTERFACE=0.0.0.0
# BACNET_PORT=47808
# BACNET_DEVICE_ID=bacnet-001

# ── Modbus RTU (serial) ─────────────────────────────────────────────────────
# SERIAL_PORT=/dev/ttyUSB0
# SERIAL_BAUD=9600
# MODBUS_RTU_UNIT_ID=1
# MODBUS_RTU_POLL_INTERVAL_MS=30000

# ── Modbus TCP (write-back) ─────────────────────────────────────────────────
# MODBUS_HOST=127.0.0.1
# MODBUS_PORT=502
# MODBUS_EXPORT_LIMIT_MIN=0
# MODBUS_EXPORT_LIMIT_MAX=100

# ── IEC 60870-5-104 (SCADA) ─────────────────────────────────────────────────
# IEC104_PORT=2404
# IEC104_COMMON_ADDRESS=1

# ── RBE Filtering (deadband thresholds) ──────────────────────────────────────
# RBE_DEADBAND_TEMPERATURE_C=0.5
# RBE_DEADBAND_VIBRATION_MM_S=0.1
# RBE_DEADBAND_POWER_DRAW_KW=0.5
# RBE_DEADBAND_DEFAULT=0

# ── Netdata ──────────────────────────────────────────────────────────────────
