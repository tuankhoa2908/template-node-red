  {
    "id": "cfg_modbus_client_env",
    "type": "modbus-client",
    "name": "MODBUS_CLIENT_FROM_ENV",
    "clienttype": "tcp",
    "bufferCommands": true,
    "stateLogEnabled": false,
    "queueLogEnabled": false,
    "failureLogEnabled": true,
    "tcpHost": "${MODBUS_HOST}",
    "tcpPort": "${MODBUS_PORT}",
    "tcpType": "DEFAULT",
    "serialPort": "/dev/ttyUSB",
    "serialType": "RTU-BUFFERD",
    "serialBaudrate": "9600",
    "serialDatabits": "8",
    "serialStopbits": "1",
    "serialParity": "none",
    "serialConnectionDelay": "100",
    "serialAsciiResponseStartDelimiter": "0x3A",
    "unit_id": "1",
    "commandDelay": "50",
    "clientTimeout": "${MODBUS_TIMEOUT_MS}",
    "reconnectOnTimeout": true,
    "reconnectTimeout": "${MODBUS_RECONNECT_MS}",
    "parallelUnitIdsAllowed": true,
    "showErrors": true,
    "showWarnings": true,
    "showLogs": false
  },
  {
    "id": "cfg_mqtt_tls_env",
    "type": "tls-config",
    "name": "MQTT_TLS_FROM_ENV",
    "cert": "",
    "key": "",
    "ca": "",
    "certname": "${MQTT_CERT}",
    "keyname": "${MQTT_KEY}",
    "caname": "${MQTT_CA}",
    "servername": "",
    "verifyservercert": "${MQTT_VERIFY_SERVER_CERT}",
    "alpnprotocol": ""
  },
  {
    "id": "cfg_mqtt_broker_env",
    "type": "mqtt-broker",
    "name": "MQTT_BROKER_FROM_ENV",
    "broker": "${MQTT_HOST}",
    "port": "${MQTT_PORT}",
    "tls": "cfg_mqtt_tls_env",
    "clientid": "${MQTT_CLIENT_ID}",
    "autoConnect": true,
    "usetls": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthRetain": "false",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closeRetain": "false",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willRetain": "false",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  }
