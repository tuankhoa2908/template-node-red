# Optional local overrides for Docker Compose.
# Docker Compose automatically reads this file after you copy it to `.env`.

TZ=UTC

# Default bind is localhost on the Pi. Use 0.0.0.0 only when you also enable
# Node-RED admin auth or put it behind a trusted network/VPN.
# NODERED_BIND=0.0.0.0

# Optional credential encryption secret for Node-RED.
# Set this before creating credentials you want to keep across redeploys.
# NODE_RED_CREDENTIAL_SECRET=change-me

# Optional editor login. NODE_RED_ADMIN_PASSWORD is easier for private Pi
# deployments. NODE_RED_ADMIN_PASS_HASH also works if you prefer storing a
# bcrypt hash.
# NODE_RED_ADMIN_USER=admin
# NODE_RED_ADMIN_PASSWORD=change-me
# NODE_RED_ADMIN_PASS_HASH=$2b$08$replace_with_generated_hash
