# ===== Site identity =====
SITE_ID=det-chungtien
SITE_NAME=S3Logger-VHouse-Det-TrungTien-Hanam
DEVICE_ID=NM2-INV01
PROJECT_TYPE=104_SOL

# ===== Paths inside Docker / Node-RED container =====
SITE_CONFIG_PATH=/data/config/site.solis.json
IEC104_CONFIG_PATH=/data/config/iec104_config.json
IEC104_DAEMON_PATH=/usr/local/bin/json-iec104-server

# ===== Modbus TCP =====
MODBUS_HOST=192.168.1.254
MODBUS_PORT=502
MODBUS_TIMEOUT_MS=1000
MODBUS_RECONNECT_MS=2000

# ===== IEC104 =====
IEC104_ASDU=3
IEC104_MODE_COMMAND=direct
IEC104_OFFLINE_UDT_TIME=5

# ===== MQTT =====
MQTT_HOST=tichhop-vhouse-1414289788.udata.ai
MQTT_PORT=8883
MQTT_CLIENT_ID=tichhop-vhouse/det-chungtien
MQTT_TOPIC=tichhop-vhouse/pms/tichhop-vhouse/det-chungtien
MQTT_QOS=0
MQTT_RETAIN=false

# ===== MQTT TLS cert paths =====
MQTT_CA=/data/certs/ca.crt
MQTT_CERT=/data/certs/client.crt
MQTT_KEY=/data/certs/client.key
MQTT_VERIFY_SERVER_CERT=true

# ===== Health check =====
INTERNET_CHECK_HOST=8.8.8.8
DEVICE_PING_HOST=10.21.10.65

# ===== Intervals =====
MODBUS_POLL_INTERVAL_SECONDS=5
IEC104_PUBLISH_INTERVAL_SECONDS=5
MQTT_PUBLISH_INTERVAL_SECONDS=15
QUEUE_FLUSH_INTERVAL_SECONDS=1
QUEUE_SAMPLE_INTERVAL_SECONDS=300
QUEUE_MAX_SIZE=10000

# ===== Snapshot =====
# Node-RED cron format: minute hour day month weekday
DAILY_SNAPSHOT_CRON=59 23 * * *
SNAPSHOT_SOURCE=a_Inv_D
SNAPSHOT_TARGET=a_Inv_D1

# ===== Node-RED context store =====
GLOBAL_STORE=default
